{
  "name": "webgl-bench",
  "version": "0.1.0",
  "description": "Pure-JS software WebGL 1.0/2.0 renderer with a GLSL ES compiler, verified against the Khronos CTS, three.js and Babylon.js.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:conformance": "tsx tests/conformance/run.ts",
    "test:threejs": "tsx tests/threejs/run.ts",
    "test:babylon": "tsx tests/babylon/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured'"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.3",
    "@types/sharp": "^0.32.0",
    "esbuild": "^0.25.6",
    "playwright": "^1.52.0",
    "sharp": "^0.33.5",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
